# ==========================================
# AgentForge Framework Configuration
# ==========================================

FRAMEWORK_NAME=AgentForge AI
VERSION=1.0.0

ENVIRONMENT=development
DEBUG=True

HOST=0.0.0.0
PORT=8000

# ==========================================
# Database
# ==========================================

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentforge

# ==========================================
# AI Providers
# ==========================================

DEFAULT_PROVIDER=gemini

GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=

OLLAMA_HOST=http://localhost:11434

# ==========================================
# Authentication
# ==========================================

JWT_SECRET=CHANGE_ME

JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================================
# Logging
# ==========================================

LOG_LEVEL=INFO

# ==========================================
# Runtime
# ==========================================

MAX_AGENT_RETRIES=3
MAX_WORKFLOW_STEPS=100
DEFAULT_TIMEOUT_SECONDS=300

# ==========================================
# Memory
# ==========================================

MAX_WORKING_MEMORY_ITEMS=100
MAX_SESSION_MEMORY_ITEMS=500